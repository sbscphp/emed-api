# --- Paystack -----------------------------------------------------------------
# One platform account. Patient payments are split to the hospital's subaccount
# at settlement, so these are eMed's keys and no hospital ever holds any.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
# What eMed keeps of each charge when a hospital has no rate of its own.
PAYSTACK_COMMISSION_PERCENT=0
# Where Paystack sends the payer back to once checkout finishes. Sent with every
# patient checkout and handed back on the pay response, so the app knows the page
# to watch for. Paystack lands the payer here whatever the outcome, with
# ?reference= and ?trxref= on the query string, so that page still has to verify.
PAYSTACK_CALLBACK_URL=
# Base of the link a patient shares when asking friends to help pay a bill.
# Set this per deploy; it is not derived from APP_ENV. Local is
# http://127.0.0.1:8000/payment-support, staging
# https://emed.quick-retail.com/payment-support, production
# https://emeddiaries.com/payment-support
PAYMENT_SUPPORT_URL=http://127.0.0.1:8000/payment-support
PAYMENT_SUPPORT_LINK_DAYS=7
